
#include <iostream>
#include <list>
#include <cstdlib>
#include <ctime>
using namespace std;

    int main()
    {
        int je = 0;
        int kolkoihje = 0;

        srand(time(0));

        while (1)
        {
            je = 0;

            list<int> kockanje;
            list<int> gambling;

            for (int i = 0; i < 7; i++)
            {
                kockanje.push_back(rand() % 45 + 1);
                gambling.push_back(rand() % 45 + 1);
            }

            for (auto itr : gambling)
            {
                for (auto x : kockanje)
                {
                    if (itr == x)
                    {
                        je++;
                    }
                }
            }
            if (je > 6)
            {
                break;
            }
            cout << endl;
            cout << endl;
            for (auto x1 : gambling)
            {
                cout << x1 << " ";
            }
            cout << endl;
            for (auto x2 : kockanje)
            {
                cout << x2 << " ";
            }
            kolkoihje++;

        }
        cout << endl;
        cout << "Broj pokusaja: " << kolkoihje << endl;

        return 0;
    }
